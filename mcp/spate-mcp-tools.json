{
    "id": 1,
    "jsonrpc": "2.0",
    "result": {
        "tools": [
            {
                "description": "Pulls the most popular trends for a category in a given region, for a give data source.",
                "inputSchema": {
                    "additionalProperties": false,
                    "properties": {
                        "category_id": {
                            "description": "Category ID. As a uuid.",
                            "type": "string"
                        },
                        "data_source": {
                            "description": "Data source. Only the popularity index is supported for now.",
                            "enum": [
                                "popindex"
                            ],
                            "type": "string"
                        },
                        "level": {
                            "description": "Categorisation level.",
                            "enum": [
                                "cat1",
                                "cat2",
                                "cat3",
                                "cat4",
                                "cat5"
                            ],
                            "type": "string"
                        },
                        "limit": {
                            "description": "Maximum number of results to return.",
                            "enum": [
                                "top5",
                                "top100",
                                "all"
                            ],
                            "type": "string"
                        },
                        "region": {
                            "description": "Region code, such as `us`.",
                            "enum": [
                                "us",
                                "gb",
                                "fr",
                                "jp",
                                "kr",
                                "global"
                            ],
                            "type": "string"
                        }
                    },
                    "required": [
                        "level",
                        "limit",
                        "data_source",
                        "region",
                        "category_id"
                    ],
                    "type": "object"
                },
                "name": "top_trends"
            },
            {
